---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "wolkengrube.de | Data, AI, Systems",
  description = "wolkengrube.de is a quiet notebook for AI systems, cloud workflows, analytics architecture, Databricks, Kubernetes, and AI-assisted coding.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>
